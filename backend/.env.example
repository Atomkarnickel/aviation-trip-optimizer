# Kopieren nach backend/.env (wird nicht committet). Alle Dienste kostenlos – siehe docs/PROVIDERS.md.
ENVIRONMENT=development
# DATABASE_URL=sqlite:///./dev.db        # Standard

# Kostenlose Preisdaten (Travelpayouts / Aviasales): Token aus dem Travelpayouts-Dashboard
TRAVELPAYOUTS_TOKEN=
TRAVELPAYOUTS_MARKER=

# Kostenloser Flugzeugtyp-Verlauf (OpenSky-Konto -> API Client)
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# Optional: Duffel (duffel_test_... = kostenlose Sandbox mit fiktiven Daten)
DUFFEL_ACCESS_TOKEN=

# Nur für Entwicklung/Vorführung: synthetische, klar gekennzeichnete Demodaten
DEMO_MODE=false
CORS_ORIGINS=http://localhost:3000,https://atomkarnickel.github.io
GITHUB_TOKEN=
