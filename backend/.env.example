# Kopieren nach backend/.env (wird nicht committet). Alle Werte sind optional.
ENVIRONMENT=development
# DATABASE_URL=postgresql://user:pass@localhost:5432/aviation   # Standard: SQLite backend/dev.db
# Flugdaten: Duffel-Token (duffel_test_... = Sandbox, duffel_live_... = echte Angebote)
DUFFEL_ACCESS_TOKEN=
# Nur für Entwicklung/Vorführung: synthetische, klar gekennzeichnete Demodaten
DEMO_MODE=false
CORS_ORIGINS=http://localhost:3000,https://atomkarnickel.github.io
# Optional: erhöht GitHub-API-Limits für die Release-Abfrage
GITHUB_TOKEN=
