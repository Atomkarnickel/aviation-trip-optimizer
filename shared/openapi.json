 "components": {
  "schemas": {
   "AircraftAssignmentStatus": {
    "type": "string",
    "enum": [
     "confirmed",
     "scheduled",
     "historical",
     "unknown"
    ],
    "title": "AircraftAssignmentStatus"
   },
   "AircraftHighlight": {
    "properties": {
     "aircraft_type_id": {
      "type": "string",
      "title": "Aircraft Type Id"
     },
     "name": {
      "type": "string",
      "title": "Name"
     },
     "status": {
      "$ref": "#/components/schemas/AircraftAssignmentStatus"
     },
     "wishlist": {
      "type": "boolean",
      "title": "Wishlist"
     },
     "segment": {
      "type": "string",
      "title": "Segment"
     }
    },
    "type": "object",
    "required": [
     "aircraft_type_id",
     "name",
     "status",
     "wishlist",
     "segment"
    ],
    "title": "AircraftHighlight"
   },
   "AircraftHistory": {
    "properties": {
     "status": {
      "type": "string",
      "title": "Status",
      "description": "ok | no_observations | not_supported | not_configured | unavailable"
     },
     "flight": {
      "type": "string",
      "title": "Flight"
     },
     "callsign": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Callsign"
     },
     "origin": {
      "type": "string",
      "title": "Origin"
     },
     "days_checked": {
      "type": "integer",
      "title": "Days Checked"
     },
     "observations": {
      "items": {
       "$ref": "#/components/schemas/AircraftObservation"
      },
      "type": "array",
      "title": "Observations",
      "default": []
     },
     "distribution": {
      "items": {
       "$ref": "#/components/schemas/AircraftTypeShare"
      },
      "type": "array",
      "title": "Distribution",
      "default": []
     },
     "source": {
      "type": "string",
      "title": "Source",
      "default": "OpenSky Network (beobachtete Flüge) + hexdb.io (Flugzeugtyp je Transponder)"
     },
     "message": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Message"
     },
     "checked_at": {
      "type": "string",
      "format": "date-time",
      "title": "Checked At"
     }
    },
    "type": "object",
    "required": [
     "status",
     "flight",
     "origin",
     "days_checked",
     "checked_at"
    ],
    "title": "AircraftHistory"
   },
   "AircraftObservation": {
    "properties": {
     "date": {
      "type": "string",
      "format": "date",
      "title": "Date"
     },
     "callsign": {
      "type": "string",
      "title": "Callsign"
     },
     "icao24": {
      "type": "string",
      "title": "Icao24"
     },
     "registration": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Registration"
     },
     "type_code": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Type Code"
     },
     "aircraft_type_id": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Aircraft Type Id"
     },
     "aircraft_name": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Aircraft Name"
     }
    },
    "type": "object",
    "required": [
     "date",
     "callsign",
     "icao24"
    ],
    "title": "AircraftObservation"
   },
   "AircraftPreference": {
    "properties": {
     "aircraft_type_id": {
      "type": "string",
      "maxLength": 8,
      "minLength": 2,
      "title": "Aircraft Type Id"
     },
     "status": {
      "$ref": "#/components/schemas/AircraftPreferenceStatus",
      "default": "neutral"
     },
     "personal_rating": {
      "anyOf": [
       {
        "type": "number",
        "maximum": 10.0,
        "minimum": 0.0
       },
       {
        "type": "null"
       }
      ],
      "title": "Personal Rating"
     }
    },
    "type": "object",
    "required": [
     "aircraft_type_id"
    ],
    "title": "AircraftPreference"
   },
   "AircraftPreferenceStatus": {
    "type": "string",
    "enum": [
     "wishlist",
     "flown",
     "not_interested",
     "neutral"
    ],
    "title": "AircraftPreferenceStatus"
   },
   "AircraftType": {
    "properties": {
     "id": {
      "type": "string",
      "title": "Id"
     },
     "manufacturer": {
      "type": "string",
      "title": "Manufacturer"
     },
     "model": {
      "type": "string",
      "title": "Model"
     },
     "family": {
      "type": "string",
      "title": "Family"
     },
     "iata_codes": {
      "items": {
       "type": "string"
      },
      "type": "array",
      "title": "Iata Codes"
     },
     "icao_codes": {
      "items": {
       "type": "string"
      },
      "type": "array",
      "title": "Icao Codes",
      "default": []
     },
     "body": {
      "type": "string",
      "title": "Body"
     },
     "engines": {
      "type": "integer",
      "title": "Engines"
     },
     "typical_seats": {
      "type": "string",
      "title": "Typical Seats"
     },
     "typical_use": {
      "type": "string",
      "title": "Typical Use"
     },
     "status": {
      "type": "string",
      "title": "Status",
      "description": "active | rare | historical"
     },
     "default_coolness": {
      "type": "number",
      "maximum": 10.0,
      "minimum": 0.0,
      "title": "Default Coolness"
     },
     "notes": {
      "type": "string",
      "title": "Notes",
      "default": ""
     },
     "bookable": {
      "type": "boolean",
      "title": "Bookable",
      "description": "False für historische Typen ohne regulären Linienbetrieb",
      "default": true
     }
    },
    "type": "object",
    "required": [
     "id",
     "manufacturer",
     "model",
     "family",
     "iata_codes",
     "body",
     "engines",
     "typical_seats",
     "typical_use",
     "status",
     "default_coolness"
    ],
