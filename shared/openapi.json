  "/api/v1/aircraft-history": {
   "get": {
    "tags": [
     "reference"
    ],
    "summary": "Aircraft History",
    "description": "Beobachtete Flugzeugtypen einer Flugnummer der letzten Tage (OpenSky + hexdb.io, kostenlos).",
    "operationId": "aircraft_history_api_v1_aircraft_history_get",
    "parameters": [
     {
      "name": "carrier",
      "in": "query",
      "required": true,
      "schema": {
       "type": "string",
       "pattern": "^[A-Za-z0-9]{2}$",
       "title": "Carrier"
      }
     },
     {
      "name": "flight_number",
      "in": "query",
      "required": true,
      "schema": {
       "type": "string",
       "pattern": "^[0-9]{1,4}[A-Za-z]?$",
       "title": "Flight Number"
      }
     },
     {
      "name": "origin",
      "in": "query",
      "required": true,
      "schema": {
       "type": "string",
       "pattern": "^[A-Za-z]{3}$",
       "title": "Origin"
      }
     },
     {
      "name": "days",
      "in": "query",
      "required": false,
      "schema": {
       "type": "integer",
       "maximum": 7,
       "minimum": 1,
       "default": 5,
       "title": "Days"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/AircraftHistory"
        }
       }
      }
     },
