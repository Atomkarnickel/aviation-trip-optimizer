<?xml version="1.0" encoding="utf-8"?>
<!-- Keine Sicherung und keine Übertragung: Standortdaten bleiben auf dem Gerät. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
    </device-transfer>
</data-extraction-rules>
